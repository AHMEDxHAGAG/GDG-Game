{
  "name": "gdgoc-pirate-identity-expedition",
  "version": "0.1.0",
  "private": true,
  "description": "GDGoC AASTMT Aswan — Discover Your Personality. A mobile-first, Arabic RTL quiz: ten multiple-choice questions scored locally into a weighted ranking of five tracks, with a downloadable username card.",
  "scripts": {
    "assets:prepare": "node tools/prepare-ui-assets.mjs && node tools/generate-artwork-manifest.mjs",
    "predev": "node tools/generate-artwork-manifest.mjs",
    "dev": "next dev",
    "prebuild": "node tools/generate-artwork-manifest.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "pretest": "node tools/generate-artwork-manifest.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tools/serve-without-supabase.sh",
    "test:e2e:only": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.54.0",
    "next": "^16.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.0",
    "jsdom": "^28.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
