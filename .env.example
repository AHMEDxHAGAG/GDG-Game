# GDGoC Pirate Identity Expedition — environment
#
# Copy to `.env.local` and adjust. Every variable is optional: with none of
# them set the app runs fully offline — the quiz, the card and the gallery are
# all local, and the team screens say so instead of failing.

# Absolute URL the projector screen's QR code points at.
# Leave unset in development and `/present` falls back to the runtime origin.
# Set it to your real deployment URL before building for the event, e.g.
#   NEXT_PUBLIC_SITE_URL=https://gdgoc-pirate-expedition.vercel.app
NEXT_PUBLIC_SITE_URL=

# Set to "true" to expose the developer-only result preview switcher in a
# production build. Development builds enable it automatically.
NEXT_PUBLIC_ENABLE_DEV_TOOLS=false

# ------------------------------------------------------------------ #
# Supabase — recording names and rooms
# ------------------------------------------------------------------ #
#
# Both values come from the Supabase dashboard:
#   Dashboard → your project → Project Settings → API
#
# The key is the **publishable** key (`sb_publishable_…`) or the legacy
# `anon` key — both are designed to ship to the browser. It is used purely as
# an anonymous key: there is no login, and the database grants that role
# nothing but `EXECUTE` on the room functions. Never put the secret key in
# here: every `NEXT_PUBLIC_` variable ends up in the client bundle.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=