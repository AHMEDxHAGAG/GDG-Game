# GDGoC Pirate Identity Expedition — environment
#
# Copy to `.env.local` and adjust. Every variable is optional: with none of
# them set the app runs fully offline against the mock conversation engine.
# There is no AI provider key, by design.

# Absolute URL the projector screen's QR code points at.
# Leave unset in development and `/present` falls back to the runtime origin.
# Set it to your real deployment URL before building for the event, e.g.
#   NEXT_PUBLIC_SITE_URL=https://gdgoc-pirate-expedition.vercel.app
NEXT_PUBLIC_SITE_URL=

# Set to "true" to expose the developer-only result preview switcher in a
# production build. Development builds enable it automatically.
NEXT_PUBLIC_ENABLE_DEV_TOOLS=false